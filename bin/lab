#!/usr/bin/env bash
# lab - AlmaShift practice runner
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/bin/lib.sh"
source "$ROOT/versions.env"
STATE="$ROOT/.lab-state"
mkdir -p "$STATE"
# Single-lab sessions (Killercoda: one scenario per lab) write the lab's directory name here;
# the other labs are then hidden, since their starting state would replace this one.
ONLY_LAB=""; [ -f "$STATE/session-lab" ] && ONLY_LAB="$(cat "$STATE/session-lab")"
COURSE_URL="https://learn.almashift.com/lms/courses/istio-fundamentals"

usage() {
  if [ -n "$ONLY_LAB" ]; then session_usage; return; fi
  cat <<USAGE
${BOLD}lab${RESET} - hands-on Istio practice

  lab list                 show all labs and your progress
  lab start <id>           (re)build a lab's starting state and show its task
  lab task                 show the task again
  lab check                grade your work
  lab hint                 reveal the next hint (use sparingly!)
  lab solution             reveal the explained solution
  lab solve                apply the reference solution to the cluster
  lab verify [id]          (authors/CI) prove start-state FAILS and solution PASSES
  lab doctor               make sure the cluster + Istio are up
  lab budget               show CPU requested vs the 2-core Codespace budget
  lab reset-cluster        delete and rebuild the whole cluster

<id> is the lab number, e.g. 1. task, check, hint, solution and solve work on the lab
you started last; add a number to pick another, e.g. lab check 3.
USAGE
}

session_usage() {  # a single-lab session only needs the commands for its own lab
  load_meta "$ROOT/labs/$ONLY_LAB"
  cat <<USAGE
${BOLD}lab${RESET} - Lab $((10#${ONLY_LAB%%-*})): ${TITLE}

  lab task        show the task again
  lab check       grade your work
  lab hint        reveal the next hint (use sparingly!)
  lab solution    show the explained solution
  lab start       reset the lab to its starting state

When lab check passes, click CHECK in the lab panel to finish.
USAGE
}

lab_dir() {  # the lab named by $1; without one, this session's lab or the lab started last
  local q="${1:-}"
  if [ -z "$q" ]; then
    q="$ONLY_LAB"
    [ -n "$q" ] || [ ! -f "$STATE/current" ] || q="$(cat "$STATE/current")"
    [ -n "$q" ] || die "Which lab? Start one first, e.g.: lab start 1   (see: lab list)"
  fi
  if [[ "$q" =~ ^[0-9]+$ ]]; then q="$(printf '%02d' "$((10#$q))")"; fi
  local m=( "$ROOT"/labs/"$q"* )
  [ -d "${m[0]}" ] || die "No lab matching '$1'. Try: lab list"
  if [ -n "$ONLY_LAB" ] && [ "$(basename "${m[0]}")" != "$ONLY_LAB" ]; then
    die "This session is for Lab $((10#${ONLY_LAB%%-*})) only. For another lab, go BACK and start its scenario, or open it from its lesson: $COURSE_URL"
  fi
  echo "${m[0]}"
}

load_meta() {  # sets TITLE DOMAIN MODES MINUTES NAMESPACE
  TITLE=""; DOMAIN=""; MODES="sidecar"; MINUTES="?"; NAMESPACE=""
  # shellcheck disable=SC1091
  source "$1/meta.env"
  # MeshMart labs set NAMESPACE=meshmart; older standalone labs default to labNN.
  [ -n "$NAMESPACE" ] || { local n; n="$(basename "$1")"; NAMESPACE="lab${n%%-*}"; }
}

current_mode() {
  if kubectl -n istio-system get ds ztunnel >/dev/null 2>&1; then echo ambient; else echo sidecar; fi
}

cleanup_other_labs() {  # delete every lab namespace (labNN, meshmart) except $1
  local keep="$1" ns
  for ns in $(kubectl get ns -o name 2>/dev/null | sed 's|namespace/||' | grep -E '^(lab[0-9]{2}|meshmart)$' || true); do
    if [ "$ns" != "$keep" ]; then
      echo "Cleaning up namespace $ns (keeps the cluster within the 2-core budget)"
      kubectl delete ns "$ns" --wait=true >/dev/null 2>&1 || true
    fi
  done
}

requested_cpu_m() {  # total CPU requests on the node, in millicores
  local out
  out="$(kubectl describe node "${CLUSTER_NAME}-control-plane" 2>/dev/null)" || return 1
  awk '
    /^  cpu /{ v=$2; if (v ~ /m$/) { sub(/m$/,"",v); print v+0 } else { print v*1000 }; exit }' <<<"$out"
}

cmd_budget() {
  local used; used="$(requested_cpu_m)"
  [ -n "$used" ] || { warn "could not read node resources"; return 1; }
  echo "CPU requested by pods: ${used}m  (budget: ${CPU_BUDGET_M}m of 2000m on the smallest Codespace)"
  if [ "$used" -le "$CPU_BUDGET_M" ]; then return 0; fi
  echo "${RED}Over budget.${RESET} Lower requests in setup/istio-install.sh or the lab manifests." >&2
  return 1
}

cmd_list() {
  printf "%s  %-3s %-46s %-22s %s\n" " " "ID" "TITLE" "DOMAIN" "MIN"
  local d n
  for d in "$ROOT"/labs/[0-9]*/; do
    d="${d%/}"; n="$(basename "$d")"
    [ -z "$ONLY_LAB" ] || [ "$n" = "$ONLY_LAB" ] || continue
    load_meta "$d"
    local mark=" "; [ -f "$STATE/$n.passed" ] && mark="${GREEN}✔${RESET}"
    printf "%s  %-3s %-46s %-22s %s\n" "$mark" "$((10#${n%%-*}))" "$TITLE" "$DOMAIN" "$MINUTES"
  done
}

cmd_start() {
  local d n; d="$(lab_dir "${1:-}")"; n="$(basename "$d")"; load_meta "$d"
  kubectl cluster-info >/dev/null 2>&1 || die "Cluster not reachable. Run: lab doctor"
  local mode; mode="$(current_mode)"
  [[ " $MODES " == *" $mode "* ]] || warn "This lab is written for '$MODES' but the cluster runs in '$mode' mode."
  cleanup_other_labs "$NAMESPACE"
  info "Preparing lab: $TITLE"
  LAB_DIR="$d" bash "$d/init.sh"
  rm -f "$STATE/$n.passed" "$STATE/$n.hints"
  date +%s > "$STATE/$n.started"
  echo "$n" > "$STATE/current"   # task/check/hint/solution default to this lab
  echo; render_md "$d/task.md"
}

cmd_task() { local d; d="$(lab_dir "${1:-}")"; render_md "$d/task.md"; }

cmd_check() {
  local d n; d="$(lab_dir "${1:-}")"; n="$(basename "$d")"
  if bash "$d/check.sh"; then
    touch "$STATE/$n.passed"
    if [ -f "$STATE/$n.started" ]; then
      local secs=$(( $(date +%s) - $(cat "$STATE/$n.started") ))
      echo "Time taken: $((secs / 60))m $((secs % 60))s"
    fi
  else
    return 1
  fi
}

cmd_hint() {
  local d n; d="$(lab_dir "${1:-}")"; n="$(basename "$d")"
  local used=0; [ -f "$STATE/$n.hints" ] && used="$(cat "$STATE/$n.hints")"
  local next=$((used + 1))
  if [ -f "$d/hints/$next.md" ]; then
    echo "$next" > "$STATE/$n.hints"
    info "Hint $next"; render_md "$d/hints/$next.md"
  else
    echo "No more hints. Try 'lab solution' if you are truly stuck."
  fi
}

cmd_solution() {
  local d n; d="$(lab_dir "${1:-}")"; n="$(basename "$d")"
  # Ask only before the lab is passed; afterwards the solution is there to compare and learn from.
  if [ "${LAB_YES:-}" != "1" ] && [ ! -f "$STATE/$n.passed" ]; then
    read -r -p "You haven't passed this lab yet. Show the solution anyway? You'll learn more if you try first. [y/N] " ans
    [[ "$ans" =~ ^[Yy]$ ]] || { echo "Good call. Try 'lab hint' first."; return 0; }
  fi
  render_md "$d/solution/explanation.md"
}

cmd_solve() { local d; d="$(lab_dir "${1:-}")"; LAB_DIR="$d" bash "$d/solution/apply.sh"; }

cmd_verify() {
  local targets=() d n out fails=0
  if [ $# -gt 0 ]; then targets=( "$(lab_dir "$1")" )
  elif [ -n "$ONLY_LAB" ]; then targets=( "$ROOT/labs/$ONLY_LAB" )
  else targets=( "$ROOT"/labs/[0-9]*/ ); fi
  for d in "${targets[@]}"; do
    d="${d%/}"; n="$(basename "$d")"
    section "verify: $n"
    load_meta "$d"; cleanup_other_labs "$NAMESPACE"
    if ! out="$(LAB_DIR="$d" bash "$d/init.sh" 2>&1)"; then bad "init.sh failed"; echo "$out" | tail -20; fails=$((fails + 1)); continue; fi
    if bash "$d/check.sh" >/dev/null 2>&1; then
      bad "the STARTING state passes the checker (it must fail)"; fails=$((fails + 1))
    else
      ok "starting state fails the checker, as it should"
    fi
    if ! out="$(LAB_DIR="$d" bash "$d/solution/apply.sh" 2>&1)"; then bad "solution/apply.sh failed"; echo "$out" | tail -20; fails=$((fails + 1)); continue; fi
    if out="$(bash "$d/check.sh" 2>&1)"; then
      ok "reference solution passes the checker"
    else
      bad "reference solution does NOT pass the checker"; echo "$out"; fails=$((fails + 1))
    fi
    if cmd_budget >/dev/null 2>&1; then
      ok "fits the 2-core budget ($(requested_cpu_m)m of ${CPU_BUDGET_M}m requested)"
    else
      bad "over the 2-core CPU budget ($(requested_cpu_m)m requested, limit ${CPU_BUDGET_M}m)"; fails=$((fails + 1))
    fi
  done
  echo
  [ "$fails" -eq 0 ] && { echo "${GREEN}${BOLD}All labs verified.${RESET}"; return 0; }
  echo "${RED}${BOLD}${fails} problem(s) found.${RESET}"; return 1
}

cmd_doctor() { bash "$ROOT/setup/ensure-cluster.sh"; }
cmd_reset_cluster() {
  command -v kind >/dev/null 2>&1 || die "This cluster isn't managed by kind. For a fresh one, restart your lab session (on Killercoda: reload the page)."
  kind delete cluster --name "$CLUSTER_NAME" || true; bash "$ROOT/setup/ensure-cluster.sh"
}

main() {
  local cmd="${1:-help}"; shift || true
  if [ -n "$ONLY_LAB" ]; then
    case "$cmd" in
      start|reset|task|check|hint|solution|help|-h|--help) ;;
      *) echo "'lab $cmd' isn't available in this lab session."; echo; usage; exit 1 ;;
    esac
  fi
  case "$cmd" in
    list)           cmd_list ;;
    start|reset)    cmd_start "$@" ;;
    task)           cmd_task "$@" ;;
    check)          cmd_check "$@" ;;
    hint)           cmd_hint "$@" ;;
    solution)       cmd_solution "$@" ;;
    solve)          cmd_solve "$@" ;;
    verify)         cmd_verify "$@" ;;
    doctor)         cmd_doctor ;;
    budget)         cmd_budget ;;
    reset-cluster)  cmd_reset_cluster ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}
main "$@"
