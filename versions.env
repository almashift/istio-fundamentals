# Single source of truth for pinned versions.
# Bump a value here, push, and let the "verify-labs" CI workflow prove every lab still works.
ISTIO_VERSION=1.27.0
K8S_VERSION=v1.33.4
KIND_VERSION=v0.30.0
# Must match ISTIO_VERSION: use the sigs.k8s.io/gateway-api version in that Istio tag's go.mod
# (1.27.0 -> v1.3.0, 1.31.1 -> v1.6.0). Bump both together.
GATEWAY_API_VERSION=v1.3.0
CLUSTER_NAME=alma
# The MeshMart example store (meshmart/app). CI builds it from source for every lab check;
# merging to master publishes this tag to GitHub Packages for students. Bump it when the app changes.
MESHMART_IMAGE=ghcr.io/almashift/meshmart:0.1.0

# Design target: the smallest Codespaces machine (2 vCPU / 8 GB RAM = 2000m CPU).
# Total pod CPU *requests* must stay under this, leaving headroom for the OS, Docker and VS Code.
CPU_BUDGET_M=1700
